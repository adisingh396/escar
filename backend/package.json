{
  "name": "@escar/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && tsc",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@escar/shared": "*",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "ulid": "^2.3.0",
    "undici": "^6.19.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^20.14.10",
    "typescript": "^5.4.5"
  }
}
